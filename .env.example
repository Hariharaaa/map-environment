# Required for deployed Vercel API routes.
# Create a Vercel Blob store and copy its read/write token here in Vercel Project Settings.
BLOB_READ_WRITE_TOKEN=

# Optional. Use private Blob storage by default because maps contain photos.
# Set to public only if your Vercel Blob store is public.
BLOB_ACCESS=private

# Optional. Keep below Vercel's 4.5 MB function request/response payload limit.
MAP_BODY_LIMIT_BYTES=4194304
